{
  "name": "vendix-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Vendix — API REST (Node.js + Express + MySQL) para el sistema de gestión de ventas e inventario (Proyecto APT, Duoc UC Valparaíso)",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/init-bd.js",
    "test": "node --no-warnings --test \"pruebas/**/*.test.js\"",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0"
  }
}
