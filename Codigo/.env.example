# Copia este archivo como ".env" y completa los valores. El archivo .env NO se sube a GitHub.

PORT=3000

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_de_mysql
DB_NAME=vendix

# Clave para firmar las sesiones (mínimo 32 caracteres, aleatoria y secreta).
# Puedes generar una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_larga_y_secreta_de_32_o_mas_caracteres
JWT_EXPIRA=7d

# Direcciones del frontend que pueden llamar a la API (separadas por coma)
CORS_ORIGENES=http://localhost:5173

# Zona horaria para decidir qué es "hoy" en las ventas
ZONA_HORARIA=America/Santiago

# Asistente de IA (opcional). Sin LLM_API_KEY el asistente responde con reglas sobre tus datos.
# Sirve cualquier proveedor compatible con la API de "chat completions" de OpenAI.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODELO=gpt-4o-mini
